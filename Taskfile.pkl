/// kawaz/pkf-tasks 自身の Taskfile (dogfooding 用、CI からも参照).
///
/// 目的:
///   1. 提供している `docs:check-translations` / `lint:pkl` / `lint:all-coverage`
///      を自リポでも使う
///   2. CI ワークフローを `pkf run ci` 1 コマンドに集約
///   3. local 開発でも `pkf run lint` / `pkf run ci` などで自リポを操作
///
/// 制限事項 (技術的制約):
///   `pkf` (pkfire 0.4.0) は pkl-go の Evaluator API を呼ぶ際に PklProject の
///   auto-detection を有効にしていない。結果 `@<dep>/...` 形式 import が project
///   not found でエラーになるため、自身を `package://...` 形式で取り込む
///   準 dogfood (= release zip 経由) になっている。pkfire 上流に PklProject
///   auto-detection の issue を上げて将来解消したい (ROADMAP)。
///
/// 0.0.10 から `all.pkl` 集約 import を採用:
///   import "package://...pkf-tasks@<version>#/all.pkl" as kawaz
///   → kawaz.vcs.* / kawaz.docs.* / kawaz.lint.* / kawaz.semver.* に透過アクセス
@ModuleInfo { minPklVersion = "0.31.0" }
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.4.0#/Taskfile.pkl"

import "package://pkg.pkl-lang.org/github.com/kawaz/pkf-tasks/pkf-tasks@0.0.12#/all.pkl" as kawaz

// =============================================================================
// CI 内部 task: smoke eval + package build
// =============================================================================

local smokeEval: Task = new {
  name = "ci:smoke-eval"
  description = "pkl eval all task modules (catches import / type errors)"
  cache = false
  workdir = "tasks"
  cmd =
    """
    set -euo pipefail
    for module in vcs/jj.pkl vcs/git.pkl vcs/auto.pkl docs/translations.pkl lint/pkl.pkl semver/check-bumped.pkl semver/compare.pkl all.pkl semver/all.pkl lint/all.pkl lint/all-coverage.pkl migrate/check-current.pkl migrate/update-self.pkl migrate/all.pkl; do
      echo "==> pkl eval $module"
      pkl eval "$module" >/dev/null
    done
    """
}

local packageBuild: Task = new {
  name = "ci:package-build"
  description = "pkl project resolve + package (verifies tasks/PklProject is publishable)"
  cache = false
  workdir = "tasks"
  cmd =
    """
    set -euo pipefail
    pkl project resolve
    pkl project package --skip-publish-check
    """
}

// =============================================================================
// User-facing umbrellas
// =============================================================================

local lint: Task = new {
  name = "lint"
  description = "lint:pkl + lint:all-coverage (dogfooded from kawaz/pkf-tasks itself)"
  cache = false
  // 0.0.11 で lint:all-coverage の孤児検出ロジックが正しく動くようになったので、
  // 自身の ci でも有効化 (vcs/jj.pkl / vcs/git.pkl の false-positive 解消)。
  deps { kawaz.lint.pkl; kawaz.lint.allCoverage }
  cmd = "echo lint ok"
}

local ci: Task = new {
  name = "ci"
  description = "smoke eval + package build + lint + docs:check-translations (full self-dogfood)"
  cache = false
  deps {
    kawaz.lint.pkl
    kawaz.lint.allCoverage
    smokeEval
    packageBuild
    kawaz.docs.checkTranslations
  }
  cmd = "echo ci ok"
}

local default: Task = new {
  name = "default"
  description = "list available tasks"
  cache = false
  cmd = "pkf list"
}

// =============================================================================
// Release flow
//
// 注: bump-semver は PklProject (Pkl module 形式) を直接読めないため、
// `semver:check-bumped` を pkf-tasks 自身に適用すると "unsupported file" エラー。
// pkf-tasks 自身の version bump 漏れは release.yml の "tag と PklProject version
// 一致" verify step に任せる。
// =============================================================================

local push: Task = (kawaz.vcs.push) {
  name = "push"
  description = "all gates → jj bookmark main → jj git push"
  deps { ci }
}

// =============================================================================
// Task registry
// =============================================================================

tasks {
  default
  lint
  ci
  smokeEval
  packageBuild
  ...kawaz.vcs.allTasks
  ...kawaz.docs.allTasks
  // lint module 群 (lint/all.pkl 経由)
  kawaz.lint.pkl
  kawaz.lint.allCoverage
  // 汎用 semver compare (v0.0.8 から、ad-hoc CLI 用)
  kawaz.semver.compare
  push
}
