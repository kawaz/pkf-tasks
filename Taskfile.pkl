/// kawaz/pkf-tasks 自身の Taskfile (dogfooding + CI 用).
///
/// 目的:
///   1. 提供している `docs:check-translations` を自リポでも使う
///   2. 自リポ専用の lint / check task (`lint:pkl` / `check:orphan-modules`) を
///      inline 定義 (v2.0.0 で library export から外し、ここに集約)
///   3. CI ワークフローを `pkf run ci` 1 コマンドに集約
///
/// 制限事項 (技術的制約):
///   `pkf` (pkfire 0.6.0) は pkl-go の Evaluator API を呼ぶ際に PklProject の
///   auto-detection を有効にしていない。結果 `@<dep>/...` 形式 import が project
///   not found でエラーになるため、自身を `package://...` 形式で取り込む
///   準 dogfood (= release zip 経由) になっている。
@ModuleInfo { minPklVersion = "0.31.0" }
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.10.0#/Taskfile.pkl"

import "package://pkg.pkl-lang.org/github.com/kawaz/pkf-tasks/pkf-tasks@2.3.0#/all.pkl" as kawaz

// =============================================================================
// Self-dogfood lint / check (v2.0.0 で library export から外して inline 化)
//
// lint:* = コード整形系 (Pkl format)
// check:* = 構造・整合性 gate (孤児 module 検出など、kawaz の semver:check-* /
//           migrate:check-* と同じ check: prefix 規約)
// =============================================================================

local lintPkl: Task = new {
  name = "lint:pkl"
  description = "pkl format -w (recursively format all Pkl files)"
  inputs {
    "**/*.pkl"
    "**/PklProject"
    "**/PklProject.deps.json"
  }
  cmd =
    """
    set -euo pipefail
    pkl format -w . >/dev/null
    """
}

local checkOrphanModules: Task = new {
  name = "check:orphan-modules"
  description = "ensure every .pkl module under tasks/ is referenced from elsewhere (no orphans)"
  cache = false
  workdir = "tasks"
  cmd =
    """
    set -euo pipefail
    missing=()
    while IFS= read -r f; do
      base=$(basename "$f")
      # f 自身を除いた全 .pkl のいずれかで base が言及されているか
      ref=$(find . -name "*.pkl" -not -path "$f" -exec grep -l -- "$base" {} \\; 2>/dev/null | head -1)
      if [ -z "$ref" ]; then
        missing+=("$f")
      fi
    done < <(find . -name "*.pkl" \\
      -not -name "PklProject*" \\
      -not -name "Taskfile.pkl" \\
      -not -name "iface.pkl" \\
      -not -name "all.pkl")
    if [ ${#missing[@]} -gt 0 ]; then
      echo 'ERROR: orphan module(s) detected (no references from other .pkl files):' >&2
      printf '  - %s\\n' "${missing[@]}" >&2
      echo '' >&2
      echo 'either re-export via all.pkl group, or import from another module under tasks/' >&2
      exit 1
    fi
    echo "ok: no orphan modules"
    """
}

// =============================================================================
// CI 内部 task: smoke eval + package build
// =============================================================================

local smokeEval: Task = new {
  name = "ci:smoke-eval"
  description = "pkl eval all task modules (catches import / type errors)"
  cache = false
  workdir = "tasks"
  cmd =
    """
    set -euo pipefail
    for module in vcs.pkl docs.pkl semver.pkl migrate.pkl all.pkl vcs/jj.pkl vcs/git.pkl vcs/auto.pkl docs/translations.pkl semver/check-bumped.pkl semver/compare.pkl migrate/check-current.pkl migrate/update-self.pkl migrate/check-pkfire-current.pkl migrate/update-pkfire.pkl; do
      echo "==> pkl eval $module"
      pkl eval "$module" >/dev/null
    done
    """
}

local packageBuild: Task = new {
  name = "ci:package-build"
  description = "pkl project resolve + package (verifies tasks/PklProject is publishable)"
  cache = false
  workdir = "tasks"
  cmd =
    """
    set -euo pipefail
    pkl project resolve
    pkl project package --skip-publish-check
    """
}

// =============================================================================
// User-facing umbrellas
// =============================================================================

local ci: Task = new {
  name = "ci"
  description =
    "lint:pkl + check:orphan-modules + smoke eval + package build + docs:check-translations"
  cache = false
  deps {
    lintPkl
    checkOrphanModules
    smokeEval
    packageBuild
    kawaz.docs.checkTranslations
  }
  cmd = ":" // umbrella、stdout を汚さない (bash noop)
}

local default: Task = new {
  name = "default"
  description = "list available tasks"
  cache = false
  cmd = "pkf list"
}

// =============================================================================
// Release flow
//
// 注: bump-semver は PklProject (Pkl module 形式) を直接読めないため、
// `semver:check-bumped` を pkf-tasks 自身に適用すると "unsupported file" エラー。
// pkf-tasks 自身の version bump 漏れは release.yml の "tag と PklProject version
// 一致" verify step に任せる。
// =============================================================================

local push: Task = (kawaz.vcs.push) {
  name = "push"
  description = "all gates → jj bookmark main → jj git push"
  deps { ci }
}

// =============================================================================
// Task registry
// =============================================================================

tasks {
  default
  lintPkl
  checkOrphanModules
  ci
  smokeEval
  packageBuild
  ...kawaz.vcs.allTasks
  ...kawaz.docs.allTasks
  // 汎用 semver compare (v0.0.8 から、ad-hoc CLI 用)
  kawaz.semver.compare
  push
}
