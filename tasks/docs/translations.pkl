/// 翻訳ペアの整合性チェック。v2.1.0 で 3 task に分割:
///
/// - `docs:check-translation-commit-lag`  — VCS timestamp 比較 (翻訳先 < 正本 = lag、失敗)
/// - `docs:check-translation-links` — 相互リンクの存在 (ja ↔ en 規約準拠)
/// - `docs:check-translations`      — 上記 2 つの umbrella (deps で並列実行)
///
/// 正本の指定方法:
///   1. CLI 引数 (acceptsArgs): `pkf run docs:check-translation-commit-lag -- '**/*-ja.md'`
///   2. function `forPairs(pairs)` で固定リスト: `(kawaz.docs.translations).forPairs(...)`
///   3. 引数なし: cwd 配下の `*-ja.md` を auto-discover (defaultPairs 空 = フォールバック)
///
/// 正本パターン:
///   - `*-ja.md` (kawaz 慣習) → 同 basename の `*.md` 群を近所探索 (e.g., `README.md`, `README-en.md`)
///   - `*.md` (en 原本など) → 同 basename の `*[_.-]*.md` 群 (e.g., `README-ja.md`, `README-zh.md`)
///   正本自身は翻訳先リストから除外、残りが check 対象。
@ModuleInfo { minPklVersion = "0.31.0" }
module com.github.kawaz.pkfTasks.docs.translations

import "@pkfire/Taskfile.pkl"

/// auto-discover 用の空 Listing (= 引数なし + Listing 空 → cwd 配下 `*-ja.md` 全部)
local defaultPairs: Listing<String> = new {}

/// 共通の bash function 群 (file_ts / discover_sources)
local sharedHelpers: String =
  #"""
  file_ts() {
    if jj root >/dev/null 2>&1; then
      jj log --no-graph -T 'committer.timestamp().format("%s")' \
        -r "latest(::@ & files('$1'))" 2>/dev/null || echo 0
    elif git rev-parse --git-dir >/dev/null 2>&1; then
      git log -1 --format=%ct -- "$1" 2>/dev/null || echo 0
    else
      echo 0
    fi
  }

  # 正本リストを決定。引数 $@ があれば glob 展開、無ければ explicit_pairs を使用、
  # 両方なければ cwd 配下の *-ja.md を auto-discover。
  collect_sources() {
    shopt -s globstar nullglob
    local sources=()
    if [ $# -gt 0 ]; then
      for arg in "$@"; do
        for f in $arg; do
          [ -f "$f" ] && sources+=("$f")
        done
      done
    elif [ -n "$explicit_pairs" ]; then
      for p in $explicit_pairs; do
        [ -f "$p" ] && sources+=("$p")
      done
    else
      while IFS= read -r f; do
        sources+=("${f#./}")
      done < <(find . -name '*-ja.md' \
        -not -path './.jj/*' \
        -not -path './.git/*' \
        -not -path '*/.out/*' \
        -not -path '*/node_modules/*' 2>/dev/null \
        | sort -u)
    fi
    printf '%s\n' "${sources[@]}"
  }

  # 正本 src に対する近所探索 (translation targets を stdout に列挙、正本自身は除外)
  neighbors_of() {
    local src="$1"
    shopt -s nullglob
    local prefix glob f
    case "$src" in
      *-ja.md) prefix="${src%-ja.md}"; glob="${prefix}*.md" ;;
      *.md)    prefix="${src%.md}";    glob="${prefix}[_.-]*.md" ;;
      *) return ;;
    esac
    for f in $glob; do
      [ "$f" = "$src" ] && continue
      [ -f "$f" ] && printf '%s\n' "$f"
    done
  }
  """#

/// commit-lag: VCS commit timestamp 比較。翻訳先 < 正本 (= lag) で失敗。
function commitLagForPairs(pairs: Listing<String>): Taskfile.Task = new Taskfile.Task {
  name = "docs:check-translation-commit-lag"
  description = "fail if any translation's commit is older than its source's (= commit lag)"
  cache = false
  acceptsArgs = true
  cmd =
    "set -euo pipefail\n"
      + "explicit_pairs='\(pairs.toList().join(" "))'\n"
      + sharedHelpers
      + #"""

      failed=0
      while IFS= read -r src; do
        src_ts=$(file_ts "$src")
        while IFS= read -r tgt; do
          tgt_ts=$(file_ts "$tgt")
          if [ "$tgt_ts" -lt "$src_ts" ]; then
            echo "translation lag: $tgt (ts=$tgt_ts) older than source $src (ts=$src_ts)" >&2
            failed=1
          fi
        done < <(neighbors_of "$src")
      done < <(collect_sources "$@")
      exit $failed
      """#
}

/// links: 相互リンクの存在チェック (ja ↔ en の 2 言語規約準拠)。
/// 多言語 (3+ 翻訳先) の場合は規約未拡張のため skip ログを出して pass。
function linksForPairs(pairs: Listing<String>): Taskfile.Task = new Taskfile.Task {
  name = "docs:check-translation-links"
  description = "bilingual cross-link integrity (ja <-> en convention)"
  cache = false
  acceptsArgs = true
  cmd =
    "set -euo pipefail\n"
      + "explicit_pairs='\(pairs.toList().join(" "))'\n"
      + sharedHelpers
      + #"""

      failed=0
      while IFS= read -r src; do
        # 翻訳先を列挙
        targets=()
        while IFS= read -r tgt; do
          targets+=("$tgt")
        done < <(neighbors_of "$src")

        # 2 言語ペア (翻訳先 1 個) の時だけリンク検査
        if [ ${#targets[@]} -ne 1 ]; then
          echo "skip link check (multilingual or no target): $src (${#targets[@]} targets)" >&2
          continue
        fi
        tgt="${targets[0]}"

        # ja ↔ en 規約: src=*-ja.md の場合、tgt=*.md (en) を期待
        case "$src" in
          *-ja.md)
            ja="$src"; en="$tgt"
            ;;
          *)
            # 正本が en 側 (= src=*.md、tgt=*-ja.md) のケース
            ja="$tgt"; en="$src"
            ;;
        esac

        base=$(basename "${ja%-ja.md}")
        if ! head -5 "$ja" | grep -qF "> [English](./${base}.md) | 日本語"; then
          echo "link check failed: $ja missing '> [English](./${base}.md) | 日本語'" >&2
          failed=1
        fi
        if ! head -5 "$en" | grep -qF "> English | [日本語](./${base}-ja.md)"; then
          echo "link check failed: $en missing '> English | [日本語](./${base}-ja.md)'" >&2
          failed=1
        fi
      done < <(collect_sources "$@")
      exit $failed
      """#
}

/// umbrella: commit-lag + links を deps で並列実行。
function forPairs(pairs: Listing<String>): Taskfile.Task = new Taskfile.Task {
  name = "docs:check-translations"
  description = "translation commit-lag + links (umbrella)"
  cache = false
  acceptsArgs = true
  deps {
    commitLagForPairs(pairs)
    linksForPairs(pairs)
  }
  cmd = "echo translation check ok"
}

/// @deprecated v3.0 で削除予定。代わりに `forPairs(...)` を使う。
@Deprecated { message = "Renamed to `forPairs`. Will be removed in v3.0." }
function task(pairs: Listing<String>): Taskfile.Task = forPairs(pairs)

/// 公開 field (defaultPairs = 空 = auto-discover)
checkTranslationCommitLag: Taskfile.Task = commitLagForPairs(defaultPairs)

checkTranslationLinks: Taskfile.Task = linksForPairs(defaultPairs)

checkTranslations: Taskfile.Task = forPairs(defaultPairs)

allTasks: Listing<Taskfile.Task> = new {
  checkTranslationCommitLag
  checkTranslationLinks
  checkTranslations
}
