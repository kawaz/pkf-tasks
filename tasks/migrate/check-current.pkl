/// 利用側 Taskfile.pkl の `pkf-tasks@<version>` import が pkf-tasks の最新 release
/// より古いと fail する gate task。`push` の deps に置いて「気づき発火点」として
/// 機能させる。
///
/// v0.0.12 から **bump-semver 経由** で最新 tag 取得 + SemVer 比較に切り替え
/// (bump-semver v0.15.0+ の `vcs:latest-tag(<repo>)` を利用):
///   - 最新 tag 取得: `bump-semver get vcs:latest-tag(kawaz/pkf-tasks)`
///   - 比較: `bump-semver compare ge <current> <latest>`
///   - DR-0006 (VCS knowledge を集約) + bump-semver/pkf-tasks の責務分担に整合
///     (bump-semver = SemVer 比較 + VCS-aware ref schema、pkf-tasks = task 合成)
///
/// 旧版 (0.0.11) の `git ls-remote --tags` ベースは bump-semver 0.15.0 が未公開
/// 時点の繋ぎ実装。bump-semver 必須化により bash の複雑な pipeline が不要に。
@ModuleInfo { minPklVersion = "0.31.0" }
module com.github.kawaz.pkfTasks.migrate.checkCurrent

import "@pkfire/Taskfile.pkl"

/// チェック対象 Taskfile.pkl のパス (利用側 repo の cwd 起点)。
taskfilePath: String = "Taskfile.pkl"

/// pkf-tasks repo spec — bump-semver の `vcs:latest-tag(<arg>)` に渡す。
/// `owner/repo` 短縮形か フル URL (`https://github.com/kawaz/pkf-tasks`) 可。
remoteRepoSpec: String = "kawaz/pkf-tasks"

/// tag 命名 prefix (DR-0003 の `pkf-tasks@<version>` 形式)。
tagPrefix: String = "pkf-tasks@"

check: Taskfile.Task = new Taskfile.Task {
  name = "migrate:check-pkf-tasks-current"
  description = "fail if \(taskfilePath) \(tagPrefix) import is behind latest released version"
  cache = false
  cmd =
    """
    set -euo pipefail
    if ! command -v bump-semver >/dev/null 2>&1; then
      echo 'ERROR: bump-semver not installed. SemVer comparison fallback is not implemented.' >&2
      echo '       Install: brew install kawaz/tap/bump-semver' >&2
      exit 1
    fi
    latest=$(bump-semver get 'vcs:latest-tag(\(remoteRepoSpec))')
    current=$(grep -oE '\(tagPrefix)[0-9]+\\.[0-9]+\\.[0-9]+' \(taskfilePath) | head -1 | sed 's|^\(tagPrefix)||')
    if [ -z "$current" ]; then
      echo "ERROR: failed to detect current \(tagPrefix) version in \(taskfilePath)" >&2
      exit 1
    fi
    if bump-semver compare ge "$current" "$latest" --no-hint; then
      exit 0
    fi
    echo "ERROR: \(taskfilePath) pkf-tasks import is behind. Current: $current, Latest: $latest" >&2
    echo "       run: pkf run migrate:update-pkf-tasks" >&2
    exit 1
    """
}
