/// `tasks/` 配下の全 `.pkl` module が `all.pkl` 群 (root or sub) で
/// re-export されていることを検証する gate task。漏れがあれば fail し、
/// 利用者に `all.pkl` への追記を促す。
///
/// 除外対象:
///   - `PklProject*` (package metadata、module ではない)
///   - `Taskfile.pkl` (dogfood 用 entry、module ではない)
///   - `iface.pkl` (abstract module、利用者は直接 import しない)
///   - `all.pkl` 自身 (集約エンドポイント、循環防止)
///
/// 設計判断:
///   現状は **検出のみ** で fail。auto-fix (all.pkl 自動再生成) は将来
///   `fix:all-coverage` として別 task で提供する想定。検出と修正を分けるのは
///   `semver:check-version-bumped` (gate) と `bump-version` (action) と同じ流儀。
@ModuleInfo { minPklVersion = "0.31.0" }
module com.github.kawaz.pkfTasks.lint.allCoverage

import "@pkfire/Taskfile.pkl"

allCoverage: Taskfile.Task = new Taskfile.Task {
  name = "lint:all-coverage"
  description = "ensure all .pkl modules under tasks/ are exported via all.pkl"
  cache = false
  workdir = "tasks"
  cmd =
    """
    set -euo pipefail
    missing=()
    while IFS= read -r f; do
      base=$(basename "$f")
      if ! grep -rql -- "$base" $(find . -name "all.pkl" -print) 2>/dev/null; then
        missing+=("$f")
      fi
    done < <(find . -name "*.pkl" \\
      -not -name "PklProject*" \\
      -not -name "Taskfile.pkl" \\
      -not -name "iface.pkl" \\
      -not -name "all.pkl")
    if [ ${#missing[@]} -gt 0 ]; then
      echo 'ERROR: all.pkl 群に未 export の module が存在:' >&2
      printf '  - %s\\n' "${missing[@]}" >&2
      echo '' >&2
      echo 'tasks/all.pkl (root) または tasks/<group>/all.pkl (sub) に re-export を追加してください' >&2
      exit 1
    fi
    echo "ok: all modules are re-exported via all.pkl"
    """
}
