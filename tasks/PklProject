amends "pkl:Project"

package {
  name = "pkf-tasks"
  baseUri = "package://pkg.pkl-lang.org/github.com/kawaz/pkf-tasks/\(name)"
  version = "2.2.0"
  packageZipUrl =
    "https://github.com/kawaz/pkf-tasks/releases/download/\(name)@\(version)/\(name)@\(version).zip"
  description = "Common Pkl task modules for pkfire (kawaz/* shared templates: vcs, docs, ...)"
  authors {
    "Yoshiaki Kawazu <kawazzz@gmail.com>"
  }
  license = "MIT"
  issueTracker = "https://github.com/kawaz/pkf-tasks/issues"
  sourceCode = "https://github.com/kawaz/pkf-tasks/tree/\(name)@\(version)/tasks"
  sourceCodeUrlScheme =
    "https://github.com/kawaz/pkf-tasks/blob/\(name)@\(version)/tasks%{path}#L%{line}-%{endLine}"
}

dependencies {
  ["pkfire"] {
    uri = "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.7.0"
  }
}
