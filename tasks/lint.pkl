/// lint group entry. 利用者は `import ".../tasks/lint.pkl" as lint` で全機能にアクセス。
///
/// v0.0.18 で flat 配置に統一 (旧 `lint/all.pkl` から移行)。
@ModuleInfo { minPklVersion = "0.31.0" }
module com.github.kawaz.pkfTasks.lint

import "@pkfire/Taskfile.pkl"

import "lint/all-coverage.pkl" as allCoverageMod
import "lint/pkl.pkl" as pklMod

/// `lint:pkl` task (`pkl format -w` を全 Pkl ファイルに適用)。
pkl = pklMod.format

/// `lint:all-coverage` task (孤児 module 検出、library 開発者向け)。
allCoverage = allCoverageMod.allCoverage

/// 一括登録用 (`tasks { ...lint.allTasks }`)。
allTasks: Listing<Taskfile.Task> = new {
  pkl
  allCoverage
}
