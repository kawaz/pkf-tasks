/// kawaz/pkf-tasks の全 module 集約エンドポイント。
///
/// 利用側で `import "package://...pkf-tasks@<version>#/all.pkl" as kawaz` 1 行で
/// 全 group にアクセスできる:
///
///   tasks {
///     ...kawaz.vcs.allTasks
///     ...kawaz.docs.allTasks
///     ...kawaz.lint.allTasks
///     ...kawaz.migrate.allTasks
///     kawaz.semver.compare
///     (kawaz.semver.checkBumped) { compareRefCmd = "..." }.check
///   }
///
/// kawaz/* の各リポジトリは pkf-tasks の全機能を使う前提なので、集約 import が
/// DRY。部分採用したい場合は `tasks/<group>.pkl` 個別 import (v1.0.0+) も可。
@ModuleInfo { minPklVersion = "0.31.0" }
module com.github.kawaz.pkfTasks.all

import "docs.pkl" as docsMod
import "lint.pkl" as lintMod
import "migrate.pkl" as migrateMod
import "semver.pkl" as semverMod
import "vcs.pkl" as vcsMod

/// vcs: jj/git auto-dispatch task primitives + Pkl function helpers。
vcs = vcsMod

/// docs: 翻訳ペア整合性チェック。
docs = docsMod

/// lint: 言語横断の Pkl format (`kawaz.lint.pkl`) + 孤児 module 検出
/// (`kawaz.lint.allCoverage`)。
lint = lintMod

/// semver: SemVer gate (`checkBumped` は module 参照、parameterize 用) +
/// ad-hoc compare (`compare` は task 直接)。`bump-semver` CLI 必須。
semver = semverMod

/// migrate: 利用側 Taskfile.pkl の upstream 追従 gate + action。
/// - `checkPkfTasks` / `updatePkfTasks` (pkf-tasks `import` URI 対象)
/// - `checkPkfire` / `updatePkfire` (pkfire `amends` URI 対象)
migrate = migrateMod
