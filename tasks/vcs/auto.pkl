/// VCS interface の entry point。実行時 (Task の cmd 内) に
/// `.jj` / `.git` の存在で jj / git を分岐する。
///
/// 設計判断:
///   - Pkl は pure な評価で FS state を見ないため、評価時に jj/git
///     を選んで module を切り替えるアプローチは取れない (relative
///     file resource read 不可)。代わりに jj.pkl / git.pkl から各々
///     cmd を取り出し、bash の if-else で連結した cmd を提供する。
///   - `.jj` を `.git` より優先 (kawaz の git-bare + jj-workspace
///     構成は両方並存するが jj が正)。
///
/// 利用側:
///   import "@pkf-tasks/vcs/auto.pkl" as vcs
///   deps { vcs.push }
@ModuleInfo { minPklVersion = "0.31.0" }
module com.github.kawaz.pkfTasks.vcs.auto

extends "iface.pkl"

import "@pkfire/Taskfile.pkl"

import "git.pkl" as git
import "jj.pkl" as jj

/// cmd を bash の if-else 構造で連結。.jj 優先。
///
/// 検出は `jj root` / `git rev-parse --git-dir` を使う (path_exists や
/// `[ -d .jj ]` は cwd 直下しか見ないので jj/git workspace のサブ
/// ディレクトリで実行すると false positive になる罠を回避)。両 CLI が
/// 親方向に repository ルートを探索してくれる。
local function autoCmd(jjCmd: String, gitCmd: String): String =
  """
  if jj root >/dev/null 2>&1; then
  \(indent(jjCmd))
  elif git rev-parse --git-dir >/dev/null 2>&1; then
  \(indent(gitCmd))
  else
    echo "vcs: no jj or git repository found from working directory" >&2
    exit 1
  fi
  """

/// 複数行 cmd を if-else の中で字下げする helper。空行に余計な
/// 空白を入れないよう、空文字列はそのまま通す。
local function indent(s: String): String =
  s.split("\n").map((line) -> if (line == "") "" else "  \(line)").join("\n")

/// jj 版 Task の構造 (params / env / cache) を base に、cmd と
/// description を auto 版で上書きする。description は jj 側の文言を
/// 残すと「jj 専用」と誤読されるため、auto.pkl で「vcs auto-detect」
/// と明示する。
commit = (jj.commit) {
  description = "vcs commit (auto-detect: jj describe+new or git commit)"
  cmd = autoCmd(jj.commit.cmd, git.commit.cmd)
}

push = (jj.push) {
  description = "vcs push (auto-detect: jj bookmark+git push or git push)"
  cmd = autoCmd(jj.push.cmd, git.push.cmd)
}

fetch = (jj.fetch) {
  description = "vcs fetch (auto-detect: jj git fetch or git fetch)"
  cmd = autoCmd(jj.fetch.cmd, git.fetch.cmd)
}

ensureClean = (jj.ensureClean) {
  description = "working copy is clean (auto-detect: jj @ empty or git porcelain empty)"
  cmd = autoCmd(jj.ensureClean.cmd, git.ensureClean.cmd)
}

fetchTags = (jj.fetchTags) {
  description = "fetch tags (auto-detect: jj git fetch+import or git fetch --tags)"
  cmd = autoCmd(jj.fetchTags.cmd, git.fetchTags.cmd)
}

/// 任意の ref と paths を比較し、変更があったファイル名一覧を返す
/// bash command substitution。$(...) として展開して使う。
///
/// Pkl 評価時点では FS state が見えないため Task の cmd 内で実行時に
/// jj/git を切り替える。利用例:
///
///   cmd = """
///     diff_out=\(diffSummary("main@origin", List("src/")))
///     [ -z "$diff_out" ] && exit 0
///     # ... bump check etc.
///   """
function diffSummary(ref: String, paths: List<String>): String =
  """
  $(if jj root >/dev/null 2>&1; then
    jj diff -r "\(ref)..@" --summary -- \(paths.join(" "))
  elif git rev-parse --git-dir >/dev/null 2>&1; then
    git diff --name-only "\(ref)" -- \(paths.join(" "))
  fi)
  """

/// 任意の ref におけるファイル内容を返す bash command substitution。
/// $(...) として展開して使う。jj は `jj file show -r <ref> -- <path>`、
/// git は `git show <ref>:<path>` で取得。
///
/// 利用例 (旧 version との比較):
///   cmd = """
///     old=\(readAtRef("main@origin", "VERSION"))
///     cur=$(cat VERSION)
///     [ "$old" != "$cur" ] && echo "bumped"
///   """
function readAtRef(ref: String, path: String): String =
  """
  $(if jj root >/dev/null 2>&1; then
    jj file show -r "\(ref)" -- \(path)
  elif git rev-parse --git-dir >/dev/null 2>&1; then
    git show "\(ref):\(path)"
  fi)
  """
