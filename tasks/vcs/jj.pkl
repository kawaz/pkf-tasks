/// VCS interface の jj 実装。
///
/// 各 task は name に `vcs:` prefix を付けて、利用側で他 task と
/// 衝突しないようにする。Task.name の regex は pkfire 0.4.0+ で
/// `/` `:` を許容しているので `vcs:commit` のキーも自然。
@ModuleInfo { minPklVersion = "0.31.0" }
module com.github.kawaz.pkfTasks.vcs.jj

extends "iface.pkl"

import "@pkfire/Taskfile.pkl"

commit = new Taskfile.Task {
  name = "vcs:commit"
  description = "jj describe -m \"...\" && jj new (caller passes message via $MESSAGE)"
  cache = false
  params {
    new Taskfile.Param {
      name = "message"
      type = "string"
      description = "commit message body"
    }
  }
  cmd =
    #"""
    jj describe -m "$MESSAGE"
    jj new
    """#
}

push = new Taskfile.Task {
  name = "vcs:push"
  description = "jj bookmark set main -r @- && jj git push --bookmark main"
  cache = false
  // SSH agent socket はホスト inherit (pkfire の inheritEnv = true デフォルト) に
  // 任せる。`env` に明示すると未設定環境 (CI 等) で `read("env:...")` が
  // resource not found で eval 失敗するため、ergonomic state は env から外す。
  cmd =
    """
    jj bookmark set main -r @-
    jj git push --bookmark main
    """
}

fetch = new Taskfile.Task {
  name = "vcs:fetch"
  description = "jj git fetch (remote bookmarks updated)"
  cache = false
  cmd = "jj git fetch"
}

ensureClean = new Taskfile.Task {
  name = "vcs:ensure-clean"
  description = "@ is empty (jj working copy is clean)"
  cache = false
  cmd =
    #"""
    [ "$(jj log -r @ --no-graph -T 'empty')" = "true" ]
    """#
}

// jj 環境での tag 同期 knowledge (DR-0006):
//   1. `jj git fetch` で remote bookmarks + (tagOpt 設定済ならば) tag を取得
//   2. `jj git import` で bare git 側で別途 fetched された tag を取り込む
//      (利用者が `git config remote.origin.tagOpt --tags` を仕込んでいない場合
//       や、別経路で bare git に tag が入った場合に効く)
// どちらも best-effort で `|| true` を付けて、ネットワーク不通や設定不備でも
// 後続の処理 (例: 既に local にある tag だけで判定する semver:check-bumped)
// が走れるようにする。
fetchTags = new Taskfile.Task {
  name = "vcs:fetch-tags"
  description = "jj git fetch + jj git import (sync tags from bare git into jj op log)"
  cache = false
  cmd =
    """
    jj git fetch || true
    jj git import || true
    """
}
